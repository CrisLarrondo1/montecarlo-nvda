#simulacion montecarlo
import numpy as np
import matplotlib.pyplot as plt
import yfinance as yf

# Parámetros
ticker = "NVDA"
dias = 30
n_sim = 10000
np.random.seed(42)  # resultados reproducibles

# 1. Datos históricos (3 años)
precios = yf.download(ticker, period="3y", auto_adjust=True)["Close"].squeeze()
ret = np.log(precios / precios.shift(1)).dropna()
mu, sigma = ret.mean(), ret.std()
S0 = precios.iloc[-1]

# 2. Simulación Montecarlo
Z = np.random.standard_normal((dias, n_sim))
tray = S0 * np.exp(np.cumsum(mu + sigma * Z, axis=0))
tray = np.vstack([np.full(n_sim, S0), tray])  # día 0 = precio actual
final = tray[-1]

# 3. Resultados
p5, p50, p95 = np.percentile(final, [5, 50, 95])
print(f"Precio actual: {S0:.3f}")
print(f"Mediana a {dias} días: {p50:.3f}")
print(f"Intervalo 90%: [{p5:.3f}, {p95:.3f}]")
print(f"Prob. de subir: {(final > S0).mean():.3f}")

# 4. Gráfico tipo abanico
hist = precios.iloc[-90:]
x_hist = np.arange(-len(hist) + 1, 1)
x_fut = np.arange(0, dias + 1)

fig, ax = plt.subplots(figsize=(11, 6))
ax.plot(x_hist, hist.values, color="black", lw=2, label="Histórico")
ax.plot(x_fut, tray[:, :60], lw=0.5, alpha=0.25, color="tab:green")
for lo, hi, a in [(5, 95, 0.15), (25, 75, 0.30)]:
    ax.fill_between(x_fut, np.percentile(tray, lo, axis=1),
                    np.percentile(tray, hi, axis=1), color="tab:green", alpha=a,
                    label=f"Rango {lo}-{hi}%")
ax.plot(x_fut, np.percentile(tray, 50, axis=1), color="darkgreen", lw=2, label="Mediana")
ax.set_title(f"{ticker}: simulación Montecarlo a {dias} días ({n_sim:,} trayectorias)")
ax.set_xlabel("Días (0 = hoy)")
ax.set_ylabel("Precio (USD)")
ax.legend()
ax.grid(alpha=0.3)
plt.tight_layout()
plt.savefig("nvda_montecarlo.png", dpi=200)
plt.show()
