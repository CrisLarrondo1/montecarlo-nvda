import numpy as np
import matplotlib.pyplot as plt
import yfinance as yf

# Parámetros
ticker = "NVDA"
dias = 30
n_sim = 10000
np.random.seed(42)

# 1. Datos y corte en el tiempo
precios = yf.download(ticker, period="4y", auto_adjust=True)["Close"].squeeze()
entrenamiento = precios.iloc[:-dias]      # lo que "sabíamos" entonces
real = precios.iloc[-dias - 1:]           # lo que pasó (día 0 incluido)

# 2. Parámetros estimados solo con el pasado
ret = np.log(entrenamiento / entrenamiento.shift(1)).dropna()
mu, sigma = ret.mean(), ret.std()
S0 = entrenamiento.iloc[-1]

# 3. Simulación
Z = np.random.standard_normal((dias, n_sim))
tray = S0 * np.exp(np.cumsum(mu + sigma * Z, axis=0))
tray = np.vstack([np.full(n_sim, S0), tray])
final = tray[-1]

# 4. Comparación con la realidad
p5, p50, p95 = np.percentile(final, [5, 50, 95])
real_final = real.iloc[-1]
print(f"Precio inicial (hace {dias} días hábiles): {S0:.3f}")
print(f"Mediana simulada: {p50:.3f}")
print(f"Intervalo 90%: [{p5:.3f}, {p95:.3f}]")
print(f"Precio real final: {real_final:.3f}")
print(f"¿Dentro del intervalo 90%?: {p5 <= real_final <= p95}")
print(f"Percentil del real en la simulación: {(final < real_final).mean():.3f}")

# 5. Gráfico
hist = entrenamiento.iloc[-90:]
x_hist = np.arange(-len(hist) + 1, 1)
x_fut = np.arange(0, dias + 1)

fig, ax = plt.subplots(figsize=(11, 6))
ax.plot(x_hist, hist.values, color="black", lw=2, label="Histórico")
ax.plot(x_fut, tray[:, :60], lw=0.5, alpha=0.2, color="tab:green")
for lo, hi, a in [(5, 95, 0.15), (25, 75, 0.30)]:
    ax.fill_between(x_fut, np.percentile(tray, lo, axis=1),
                    np.percentile(tray, hi, axis=1), color="tab:green",
                    alpha=a, label=f"Rango {lo}-{hi}%")
ax.plot(x_fut, np.percentile(tray, 50, axis=1), color="darkgreen", lw=2, label="Mediana simulada")
ax.plot(x_fut, real.values, color="red", lw=2.5, label="Precio real")
ax.set_title(f"{ticker}: backtest Montecarlo a {dias} días ({n_sim:,} trayectorias)")
ax.set_xlabel("Días (0 = fecha de corte)")
ax.set_ylabel("Precio (USD)")
ax.legend()
ax.grid(alpha=0.3)
plt.tight_layout()
plt.savefig("nvda_backtest.png", dpi=200)
plt.show()


